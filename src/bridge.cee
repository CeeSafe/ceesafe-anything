// `bridge`: scaffold a pure CeeSafe library package (`ceesafe.toml`, `src/port.cee`, `src/bridge.cee`,
// `include/<name>.h`, `ceesafe-anything.json`) for one source unit. Never overwrites an existing port.

public struct Bridge {
    public fn buildManifestJson(root: StringView, unit: StringView, pkgName: StringView) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "{\n")?;
        StrUtil.append(mut out, "  \"schema\": \"ceesafe-anything/bridge@1\",\n")?;
        StrUtil.append(mut out, "  \"root\": \"")?;
        StrUtil.appendJsonEscaped(mut out, root)?;
        StrUtil.append(mut out, "\",\n")?;
        StrUtil.append(mut out, "  \"unit\": \"")?;
        StrUtil.appendJsonEscaped(mut out, unit)?;
        StrUtil.append(mut out, "\",\n")?;
        StrUtil.append(mut out, "  \"package_name\": \"")?;
        StrUtil.appendJsonEscaped(mut out, pkgName)?;
        StrUtil.append(mut out, "\",\n")?;
        StrUtil.append(mut out, "  \"target\": \"ceesafe-c-abi\"\n")?;
        StrUtil.append(mut out, "}\n")?;
        return Ok(out);
    }

    public fn buildCeesafeToml(pkgName: StringView) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "[package]\nname = \"")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, "\"\nversion = \"0.1.0\"\nkind = \"library\"\n\n[dependencies]\n")?;
        return Ok(out);
    }

    public fn buildPortCee(unit: StringView, pkgName: StringView) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "// Safe CeeSafe port of `")?;
        StrUtil.append(mut out, unit)?;
        StrUtil.append(mut out, "`.\n")?;
        StrUtil.append(mut out, "// Replace the stub below with the ported functions and add `@test` cases.\n")?;
        StrUtil.append(
            mut out,
            "// CeeSafe rules: handle AllocError explicitly, keep `unsafe` in src/bridge.cee only.\n\n",
        )?;
        StrUtil.append(mut out, "public struct ")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, "_port {\n")?;
        StrUtil.append(mut out, "    public fn run(input: Slice<u8>) -> i32 {\n")?;
        StrUtil.append(mut out, "        let _ = input;\n")?;
        StrUtil.append(mut out, "        panic(\"unimplemented: port ")?;
        StrUtil.append(mut out, unit)?;
        StrUtil.append(mut out, "\");\n")?;
        StrUtil.append(mut out, "    }\n")?;
        StrUtil.append(mut out, "}\n")?;
        return Ok(out);
    }

    public fn buildBridgeCee(unit: StringView, pkgName: StringView) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "// C-ABI boundary for `")?;
        StrUtil.append(mut out, unit)?;
        StrUtil.append(mut out, "` (generated by ceesafe-anything).\n")?;
        StrUtil.append(
            mut out,
            "// All `unsafe` pointer conversions live here with `/// Safety:` and `// SAFETY:` comments.\n\n",
        )?;
        StrUtil.append(
            mut out,
            "/// Safety: caller passes `len` readable bytes at `ptr` for the duration of the call.\n",
        )?;
        StrUtil.append(mut out, "@export(\"port_")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, "_run\")\n")?;
        StrUtil.append(mut out, "public fn bridge_run(ptr: *u8, len: usize) -> i32 {\n")?;
        StrUtil.append(mut out, "    if (ptr.isNull() || len == 0) {\n")?;
        StrUtil.append(mut out, "        let empty = [0u8; 1];\n")?;
        StrUtil.append(mut out, "        return ")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, "_port.run(empty[0..0]);\n")?;
        StrUtil.append(mut out, "    }\n")?;
        StrUtil.append(
            mut out,
            "    // SAFETY: caller passes `len` readable bytes at `ptr` for the duration of the call.\n",
        )?;
        StrUtil.append(mut out, "    let slice = unsafe { Slice.fromRaw(ptr, len) };\n")?;
        StrUtil.append(mut out, "    return ")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, "_port.run(slice);\n")?;
        StrUtil.append(mut out, "}\n")?;
        return Ok(out);
    }

    public fn buildHeader(unit: StringView, pkgName: StringView) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "/* C ABI of CeeSafe port of `")?;
        StrUtil.append(mut out, unit)?;
        StrUtil.append(mut out, "`, generated by ceesafe-anything. */\n")?;
        StrUtil.append(mut out, "#ifndef PORT_")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, "_H\n#define PORT_")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, "_H\n\n#include <stddef.h>\n#include <stdint.h>\n\n")?;
        StrUtil.append(mut out, "int32_t port_")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, "_run(const uint8_t *ptr, size_t len);\n\n#endif\n")?;
        return Ok(out);
    }

    public fn buildReadme(unit: StringView, pkgName: StringView) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "# ")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, "\n\nCeeSafe port of `")?;
        StrUtil.append(mut out, unit)?;
        StrUtil.append(mut out, "`, generated by `ceesafe-anything`.\n\n## Loop\n\n```sh\n")?;
        StrUtil.append(mut out, "ceesafec check --deny-warnings\n")?;
        StrUtil.append(mut out, "ceesafec test\n")?;
        StrUtil.append(mut out, "ceesafe-anything build .\n")?;
        StrUtil.append(mut out, "ceesafe-anything gate .\n")?;
        StrUtil.append(mut out, "```\n")?;
        return Ok(out);
    }

    public fn run(root: StringView, unit: StringView, outOpt: StringView?) -> Result<String, AppError> {
        let stem = StrUtil.stem(unit);
        let pkgName = StrUtil.sanitizeIdent(stem)?;
        let outDir = match (outOpt) {
            Some(p) => StrUtil.cloneView(p)?,
            null => {
                let ceesafeDir = StrUtil.joinPath(root, "ceesafe")?;
                FsUtil.ensureDir(ceesafeDir.view())?;
                StrUtil.joinPath(ceesafeDir.view(), pkgName.view())?
            }
        };
        let manifestPath = StrUtil.joinPath(outDir.view(), "ceesafe-anything.json")?;
        if (FsUtil.fileExists(manifestPath.view())) {
            return Err(AppError.AlreadyExists);
        }

        FsUtil.ensureDir(outDir.view())?;
        let srcDir = StrUtil.joinPath(outDir.view(), "src")?;
        FsUtil.ensureDir(srcDir.view())?;
        let incDir = StrUtil.joinPath(outDir.view(), "include")?;
        FsUtil.ensureDir(incDir.view())?;

        let tomlPath = StrUtil.joinPath(outDir.view(), "ceesafe.toml")?;
        let tomlText = Bridge.buildCeesafeToml(pkgName.view())?;
        FsUtil.writeText(tomlPath.view(), tomlText.view())?;

        let portPath = StrUtil.joinPath(srcDir.view(), "port.cee")?;
        let portText = Bridge.buildPortCee(unit, pkgName.view())?;
        FsUtil.writeText(portPath.view(), portText.view())?;

        let bridgePath = StrUtil.joinPath(srcDir.view(), "bridge.cee")?;
        let bridgeText = Bridge.buildBridgeCee(unit, pkgName.view())?;
        FsUtil.writeText(bridgePath.view(), bridgeText.view())?;

        var hdrName = StrUtil.cloneView(pkgName.view())?;
        StrUtil.append(mut hdrName, ".h")?;
        let hdrPath = StrUtil.joinPath(incDir.view(), hdrName.view())?;
        let hdrText = Bridge.buildHeader(unit, pkgName.view())?;
        FsUtil.writeText(hdrPath.view(), hdrText.view())?;

        let gitignorePath = StrUtil.joinPath(outDir.view(), ".gitignore")?;
        FsUtil.writeText(gitignorePath.view(), "out/\n.ceesafe-anything/\n")?;

        let readmePath = StrUtil.joinPath(outDir.view(), "README.md")?;
        let readmeText = Bridge.buildReadme(unit, pkgName.view())?;
        FsUtil.writeText(readmePath.view(), readmeText.view())?;

        let manifestText = Bridge.buildManifestJson(root, unit, pkgName.view())?;
        FsUtil.writeText(manifestPath.view(), manifestText.view())?;

        var summary = String.create();
        StrUtil.append(mut summary, "Scaffolded CeeSafe package at ")?;
        StrUtil.append(mut summary, outDir.view())?;
        StrUtil.append(mut summary, "\n  - ceesafe.toml\n  - src/port.cee\n  - src/bridge.cee\n  - include/")?;
        StrUtil.append(mut summary, hdrName.view())?;
        StrUtil.append(mut summary, "\n  - ceesafe-anything.json\n")?;
        return Ok(summary);
    }
}
