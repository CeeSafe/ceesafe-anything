// `bridge`: scaffold a pure CeeSafe library package (`ceesafe.toml`, `src/port.cee`, `src/bridge.cee`,
// optional `src/types.cee`, `include/<name>.h`, `ceesafe-anything.json`) for one source unit.

public struct Bridge {
    fn cTypeForAbi(abi: StringView) -> StringView {
        if (abi == "u32") { return "uint32_t"; }
        if (abi == "i64") { return "int64_t"; }
        if (abi == "u64") { return "uint64_t"; }
        if (abi == "usize") { return "size_t"; }
        if (abi == "f64") { return "double"; }
        if (abi == "bool") { return "bool"; }
        if (abi == "void") { return "void"; }
        return "int32_t";
    }

    fn fieldByteSize(abi: StringView) -> u64 {
        if (abi == "i64" || abi == "u64" || abi == "usize" || abi == "f64") { return 8; }
        if (abi == "bool") { return 1; }
        return 4;
    }

    fn defaultExports() -> Result<Vector<FnSpec>, AppError> {
        var fns = Vector<FnSpec>.create();
        var params = Vector<ParamSpec>.create();
        match (params.push(ParamSpec {
            name: StrUtil.cloneView("input")?,
            ceeType: StrUtil.cloneView("Slice<u8>")?,
            abiKind: StrUtil.cloneView("bytes")?,
        })) {
            Ok() => {}
            Err(_) => { return Err(AppError.OutOfMemory); }
        }
        match (fns.push(FnSpec {
            name: StrUtil.cloneView("run")?,
            returnType: StrUtil.cloneView("i32")?,
            params: params,
        })) {
            Ok() => {}
            Err(_) => { return Err(AppError.OutOfMemory); }
        }
        return Ok(fns);
    }

    public fn buildTypesCee(
        structs: borrow Vector<StructSpec>,
        enums: borrow Vector<EnumSpec>,
    ) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "// Generated C struct and enum types for CeeSafe FFI.\n\n")?;
        if (structs.length > 0) {
            StrUtil.append(mut out, "public struct FfiCodec {\n")?;
            StrUtil.append(mut out, "    public fn readU32Le(b: Slice<u8>, off: usize) -> u32 {\n")?;
            StrUtil.append(mut out, "        if (off + 4 > b.length) { return 0; }\n")?;
            StrUtil.append(
                mut out,
                "        return (b[off] as u32) | ((b[off + 1] as u32) << 8) | ((b[off + 2] as u32) << 16) | ((b[off + 3] as u32) << 24);\n",
            )?;
            StrUtil.append(mut out, "    }\n\n")?;
            StrUtil.append(mut out, "    public fn readU64Le(b: Slice<u8>, off: usize) -> u64 {\n")?;
            StrUtil.append(mut out, "        if (off + 8 > b.length) { return 0; }\n")?;
            StrUtil.append(mut out, "        let lo = FfiCodec.readU32Le(b, off) as u64;\n")?;
            StrUtil.append(mut out, "        let hi = FfiCodec.readU32Le(b, off + 4) as u64;\n")?;
            StrUtil.append(mut out, "        return lo | (hi << 32);\n")?;
            StrUtil.append(mut out, "    }\n}\n\n")?;
        }
        for (i in 0..enums.length) {
            let ename = enums[i].name.view();
            StrUtil.append(mut out, "public enum ")?;
            StrUtil.append(mut out, ename)?;
            StrUtil.append(mut out, " {\n")?;
            for (j in 0..enums[i].variants.length) {
                StrUtil.append(mut out, "    ")?;
                StrUtil.append(mut out, enums[i].variants[j].view())?;
                StrUtil.append(mut out, ",\n")?;
            }
            StrUtil.append(mut out, "}\n\npublic struct ")?;
            StrUtil.append(mut out, ename)?;
            StrUtil.append(mut out, "_ffi {\n    public fn fromI32(v: i32) -> ")?;
            StrUtil.append(mut out, ename)?;
            StrUtil.append(mut out, " {\n")?;
            for (j in 1..enums[i].variants.length) {
                StrUtil.append(mut out, "        if (v == ")?;
                StrUtil.appendNum(mut out, j as u64)?;
                StrUtil.append(mut out, ") { return ")?;
                StrUtil.append(mut out, ename)?;
                StrUtil.append(mut out, ".")?;
                StrUtil.append(mut out, enums[i].variants[j].view())?;
                StrUtil.append(mut out, "; }\n")?;
            }
            StrUtil.append(mut out, "        return ")?;
            StrUtil.append(mut out, ename)?;
            StrUtil.append(mut out, ".")?;
            StrUtil.append(mut out, enums[i].variants[0].view())?;
            StrUtil.append(mut out, ";\n    }\n}\n\n")?;
        }
        for (i in 0..structs.length) {
            let sname = structs[i].name.view();
            StrUtil.append(mut out, "public struct ")?;
            StrUtil.append(mut out, sname)?;
            StrUtil.append(mut out, " {\n")?;
            var totalBytes: u64 = 0;
            for (j in 0..structs[i].fields.length) {
                StrUtil.append(mut out, "    public ")?;
                StrUtil.append(mut out, structs[i].fields[j].name.view())?;
                StrUtil.append(mut out, ": ")?;
                StrUtil.append(mut out, structs[i].fields[j].ceeType.view())?;
                StrUtil.append(mut out, ";\n")?;
                totalBytes += Bridge.fieldByteSize(structs[i].fields[j].abiKind.view());
            }
            StrUtil.append(mut out, "\n    public fn byteSize() -> usize => ")?;
            StrUtil.appendNum(mut out, totalBytes)?;
            StrUtil.append(mut out, ";\n\n    public fn fromBytes(b: Slice<u8>) -> ")?;
            StrUtil.append(mut out, sname)?;
            StrUtil.append(mut out, " {\n        return ")?;
            StrUtil.append(mut out, sname)?;
            StrUtil.append(mut out, " {\n")?;
            var off: u64 = 0;
            for (j in 0..structs[i].fields.length) {
                let fnm = structs[i].fields[j].name.view();
                let fk = structs[i].fields[j].abiKind.view();
                StrUtil.append(mut out, "            ")?;
                StrUtil.append(mut out, fnm)?;
                StrUtil.append(mut out, ": ")?;
                if (fk == "u32") {
                    StrUtil.append(mut out, "FfiCodec.readU32Le(b, ")?;
                    StrUtil.appendNum(mut out, off)?;
                    StrUtil.append(mut out, ")")?;
                } else if (fk == "u64") {
                    StrUtil.append(mut out, "FfiCodec.readU64Le(b, ")?;
                    StrUtil.appendNum(mut out, off)?;
                    StrUtil.append(mut out, ")")?;
                } else if (fk == "i64") {
                    StrUtil.append(mut out, "truncate<i64>(FfiCodec.readU64Le(b, ")?;
                    StrUtil.appendNum(mut out, off)?;
                    StrUtil.append(mut out, "))")?;
                } else if (fk == "usize") {
                    StrUtil.append(mut out, "truncate<usize>(FfiCodec.readU64Le(b, ")?;
                    StrUtil.appendNum(mut out, off)?;
                    StrUtil.append(mut out, "))")?;
                } else if (fk == "bool") {
                    StrUtil.append(mut out, "if (")?;
                    StrUtil.appendNum(mut out, off)?;
                    StrUtil.append(mut out, " < b.length) b[")?;
                    StrUtil.appendNum(mut out, off)?;
                    StrUtil.append(mut out, "] != 0 else false")?;
                } else {
                    StrUtil.append(mut out, "truncate<i32>(FfiCodec.readU32Le(b, ")?;
                    StrUtil.appendNum(mut out, off)?;
                    StrUtil.append(mut out, "))")?;
                }
                StrUtil.append(mut out, ",\n")?;
                off += Bridge.fieldByteSize(fk);
            }
            StrUtil.append(mut out, "        };\n    }\n}\n\n")?;
        }
        return Ok(out);
    }

    public fn buildManifestJson(
        root: StringView,
        unit: StringView,
        pkgName: StringView,
        fns: borrow Vector<FnSpec>,
        structs: borrow Vector<StructSpec>,
        enums: borrow Vector<EnumSpec>,
    ) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "{\n")?;
        StrUtil.append(mut out, "  \"schema\": \"ceesafe-anything/bridge@2\",\n")?;
        StrUtil.append(mut out, "  \"root\": \"")?;
        StrUtil.appendJsonEscaped(mut out, root)?;
        StrUtil.append(mut out, "\",\n")?;
        StrUtil.append(mut out, "  \"unit\": \"")?;
        StrUtil.appendJsonEscaped(mut out, unit)?;
        StrUtil.append(mut out, "\",\n")?;
        StrUtil.append(mut out, "  \"package_name\": \"")?;
        StrUtil.appendJsonEscaped(mut out, pkgName)?;
        StrUtil.append(mut out, "\",\n")?;
        StrUtil.append(mut out, "  \"target\": \"ceesafe-c-abi\",\n")?;
        StrUtil.append(mut out, "  \"structs\": [")?;
        for (i in 0..structs.length) {
            if (i > 0) { StrUtil.append(mut out, ", ")?; }
            StrUtil.append(mut out, "{\"name\": \"")?;
            StrUtil.appendJsonEscaped(mut out, structs[i].name.view())?;
            StrUtil.append(mut out, "\", \"fields\": [")?;
            for (j in 0..structs[i].fields.length) {
                if (j > 0) { StrUtil.append(mut out, ", ")?; }
                StrUtil.append(mut out, "{\"name\": \"")?;
                StrUtil.appendJsonEscaped(mut out, structs[i].fields[j].name.view())?;
                StrUtil.append(mut out, "\", \"kind\": \"")?;
                StrUtil.append(mut out, structs[i].fields[j].abiKind.view())?;
                StrUtil.append(mut out, "\"}")?;
            }
            StrUtil.append(mut out, "]}")?;
        }
        StrUtil.append(mut out, "],\n  \"enums\": [")?;
        for (i in 0..enums.length) {
            if (i > 0) { StrUtil.append(mut out, ", ")?; }
            StrUtil.append(mut out, "{\"name\": \"")?;
            StrUtil.appendJsonEscaped(mut out, enums[i].name.view())?;
            StrUtil.append(mut out, "\", \"variants\": [")?;
            for (j in 0..enums[i].variants.length) {
                if (j > 0) { StrUtil.append(mut out, ", ")?; }
                StrUtil.append(mut out, "\"")?;
                StrUtil.appendJsonEscaped(mut out, enums[i].variants[j].view())?;
                StrUtil.append(mut out, "\"")?;
            }
            StrUtil.append(mut out, "]}")?;
        }
        StrUtil.append(mut out, "],\n  \"exports\": [\n")?;
        for (i in 0..fns.length) {
            if (i > 0) { StrUtil.append(mut out, ",\n")?; }
            StrUtil.append(mut out, "    {\"name\": \"")?;
            StrUtil.appendJsonEscaped(mut out, fns[i].name.view())?;
            StrUtil.append(mut out, "\", \"symbol\": \"port_")?;
            StrUtil.append(mut out, pkgName)?;
            StrUtil.append(mut out, "_")?;
            StrUtil.appendJsonEscaped(mut out, fns[i].name.view())?;
            StrUtil.append(mut out, "\", \"return\": \"")?;
            StrUtil.append(mut out, fns[i].returnType.view())?;
            StrUtil.append(mut out, "\", \"params\": [")?;
            for (j in 0..fns[i].params.length) {
                if (j > 0) { StrUtil.append(mut out, ", ")?; }
                StrUtil.append(mut out, "{\"name\": \"")?;
                StrUtil.appendJsonEscaped(mut out, fns[i].params[j].name.view())?;
                StrUtil.append(mut out, "\", \"kind\": \"")?;
                StrUtil.append(mut out, fns[i].params[j].abiKind.view())?;
                StrUtil.append(mut out, "\"}")?;
            }
            StrUtil.append(mut out, "]}")?;
        }
        StrUtil.append(mut out, "\n  ]\n}\n")?;
        return Ok(out);
    }

    public fn buildCeesafeToml(pkgName: StringView) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "[package]\nname = \"")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, "\"\nversion = \"0.1.0\"\nkind = \"library\"\n\n[dependencies]\n")?;
        return Ok(out);
    }

    public fn buildPortCee(
        unit: StringView,
        pkgName: StringView,
        fns: borrow Vector<FnSpec>,
    ) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "// Safe CeeSafe port of `")?;
        StrUtil.append(mut out, unit)?;
        StrUtil.append(mut out, "`.\n")?;
        StrUtil.append(mut out, "// Replace each stub below with the ported function and add `@test` cases.\n\n")?;
        StrUtil.append(mut out, "public struct ")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, "_port {\n")?;
        for (i in 0..fns.length) {
            if (i > 0) { StrUtil.append(mut out, "\n")?; }
            StrUtil.append(mut out, "    public fn ")?;
            StrUtil.append(mut out, fns[i].name.view())?;
            StrUtil.append(mut out, "(")?;
            for (j in 0..fns[i].params.length) {
                if (j > 0) { StrUtil.append(mut out, ", ")?; }
                StrUtil.append(mut out, fns[i].params[j].name.view())?;
                StrUtil.append(mut out, ": ")?;
                StrUtil.append(mut out, fns[i].params[j].ceeType.view())?;
            }
            StrUtil.append(mut out, ")")?;
            if (fns[i].returnType.view() != "void") {
                StrUtil.append(mut out, " -> ")?;
                StrUtil.append(mut out, fns[i].returnType.view())?;
            }
            StrUtil.append(mut out, " {\n")?;
            for (j in 0..fns[i].params.length) {
                StrUtil.append(mut out, "        let _ = ")?;
                StrUtil.append(mut out, fns[i].params[j].name.view())?;
                StrUtil.append(mut out, ";\n")?;
            }
            StrUtil.append(mut out, "        panic(\"unimplemented: port ")?;
            StrUtil.append(mut out, fns[i].name.view())?;
            StrUtil.append(mut out, "\");\n    }\n")?;
        }
        StrUtil.append(mut out, "}\n")?;
        return Ok(out);
    }

    public fn buildBridgeCee(
        unit: StringView,
        pkgName: StringView,
        fns: borrow Vector<FnSpec>,
    ) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "// C-ABI boundary for `")?;
        StrUtil.append(mut out, unit)?;
        StrUtil.append(mut out, "` (generated by ceesafe-anything).\n")?;
        var anyCstr = false;
        for (i in 0..fns.length) {
            for (j in 0..fns[i].params.length) {
                if (fns[i].params[j].abiKind.view() == "cstr") { anyCstr = true; }
            }
        }
        if (anyCstr) {
            StrUtil.append(mut out, "\nextern \"C\" {\n    @effects()\n    fn strlen(s: *u8) -> usize;\n}\n")?;
        }
        for (i in 0..fns.length) {
            var usesUnsafe = false;
            for (j in 0..fns[i].params.length) {
                let k = fns[i].params[j].abiKind.view();
                if (k == "bytes" || k == "cstr" || k == "buffer" || StrUtil.startsWith(k, "struct_ptr:")) {
                    usesUnsafe = true;
                }
            }
            StrUtil.append(mut out, "\n")?;
            if (usesUnsafe) {
                StrUtil.append(
                    mut out,
                    "/// Safety: caller passes valid readable/writable memory for each pointer argument for the duration of the call.\n",
                )?;
            }
            StrUtil.append(mut out, "@export(\"port_")?;
            StrUtil.append(mut out, pkgName)?;
            StrUtil.append(mut out, "_")?;
            StrUtil.append(mut out, fns[i].name.view())?;
            StrUtil.append(mut out, "\")\npublic fn bridge_")?;
            StrUtil.append(mut out, fns[i].name.view())?;
            StrUtil.append(mut out, "(")?;
            for (j in 0..fns[i].params.length) {
                if (j > 0) { StrUtil.append(mut out, ", ")?; }
                let k = fns[i].params[j].abiKind.view();
                let pn = fns[i].params[j].name.view();
                if (k == "bytes") {
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_ptr: *u8, ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_len: usize")?;
                } else if (k == "buffer") {
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_ptr: *mut u8, ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_len: usize")?;
                } else if (k == "cstr" || StrUtil.startsWith(k, "struct_ptr:")) {
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_ptr: *u8")?;
                } else if (StrUtil.startsWith(k, "enum:")) {
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_raw: i32")?;
                } else {
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, ": ")?;
                    StrUtil.append(mut out, fns[i].params[j].ceeType.view())?;
                }
            }
            StrUtil.append(mut out, ")")?;
            if (fns[i].returnType.view() != "void") {
                StrUtil.append(mut out, " -> ")?;
                StrUtil.append(mut out, fns[i].returnType.view())?;
            }
            StrUtil.append(mut out, " {\n")?;
            for (j in 0..fns[i].params.length) {
                let k = fns[i].params[j].abiKind.view();
                let pn = fns[i].params[j].name.view();
                if (k == "bytes") {
                    StrUtil.append(mut out, "    let ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(
                        mut out,
                        "_empty = [0u8; 1];\n    // SAFETY: caller passes readable bytes at pointer for the duration of the call.\n    let ",
                    )?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, " = if (")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_ptr.isNull() || ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_len == 0) ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_empty[0..0] else unsafe { Slice.fromRaw(")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_ptr, ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_len) };\n")?;
                } else if (k == "cstr") {
                    StrUtil.append(mut out, "    let ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(
                        mut out,
                        "_empty = [0u8; 1];\n    // SAFETY: caller passes a valid NUL-terminated C string for the duration of the call.\n    let ",
                    )?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, " = if (")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_ptr.isNull()) ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_empty[0..0] else unsafe { Slice.fromRaw(")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_ptr, strlen(")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_ptr)) };\n")?;
                } else if (k == "buffer") {
                    StrUtil.append(mut out, "    var ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(
                        mut out,
                        "_empty = [0u8; 1];\n    // SAFETY: caller passes exclusive writable bytes at pointer for the duration of the call.\n    let ",
                    )?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, " = if (")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_ptr.isNull() || ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_len == 0) borrow mut ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_empty[0..0] else unsafe { SliceMut.fromRaw(")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_ptr, ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_len) };\n")?;
                } else if (StrUtil.startsWith(k, "struct_ptr:")) {
                    let sname = k[11..k.bytes().length];
                    StrUtil.append(mut out, "    let ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(
                        mut out,
                        "_empty = [0u8; 1];\n    // SAFETY: caller passes a valid readable struct pointer for the duration of the call.\n    let ",
                    )?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_bytes = if (")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_ptr.isNull()) ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_empty[0..0] else unsafe { Slice.fromRaw(")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_ptr, ")?;
                    StrUtil.append(mut out, sname)?;
                    StrUtil.append(mut out, ".byteSize()) };\n    let ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, " = ")?;
                    StrUtil.append(mut out, sname)?;
                    StrUtil.append(mut out, ".fromBytes(")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_bytes);\n")?;
                } else if (StrUtil.startsWith(k, "enum:")) {
                    let ename = k[5..k.bytes().length];
                    StrUtil.append(mut out, "    let ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, " = ")?;
                    StrUtil.append(mut out, ename)?;
                    StrUtil.append(mut out, "_ffi.fromI32(")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_raw);\n")?;
                }
            }
            if (fns[i].returnType.view() != "void") {
                StrUtil.append(mut out, "    return ")?;
            } else {
                StrUtil.append(mut out, "    ")?;
            }
            StrUtil.append(mut out, pkgName)?;
            StrUtil.append(mut out, "_port.")?;
            StrUtil.append(mut out, fns[i].name.view())?;
            StrUtil.append(mut out, "(")?;
            for (j in 0..fns[i].params.length) {
                if (j > 0) { StrUtil.append(mut out, ", ")?; }
                StrUtil.append(mut out, fns[i].params[j].name.view())?;
            }
            StrUtil.append(mut out, ");\n}\n")?;
        }
        return Ok(out);
    }

    public fn buildHeader(
        unit: StringView,
        pkgName: StringView,
        fns: borrow Vector<FnSpec>,
        structs: borrow Vector<StructSpec>,
        enums: borrow Vector<EnumSpec>,
    ) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "/* C ABI of CeeSafe port of `")?;
        StrUtil.append(mut out, unit)?;
        StrUtil.append(mut out, "`, generated by ceesafe-anything. */\n#ifndef PORT_")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, "_H\n#define PORT_")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, "_H\n\n#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n\n")?;
        for (i in 0..enums.length) {
            StrUtil.append(mut out, "typedef enum {\n")?;
            for (j in 0..enums[i].variants.length) {
                StrUtil.append(mut out, "    ")?;
                StrUtil.append(mut out, enums[i].variants[j].view())?;
                StrUtil.append(mut out, " = ")?;
                StrUtil.appendNum(mut out, j as u64)?;
                StrUtil.append(mut out, ",\n")?;
            }
            StrUtil.append(mut out, "} ")?;
            StrUtil.append(mut out, enums[i].name.view())?;
            StrUtil.append(mut out, ";\n\n")?;
        }
        for (i in 0..structs.length) {
            StrUtil.append(mut out, "typedef struct {\n")?;
            for (j in 0..structs[i].fields.length) {
                StrUtil.append(mut out, "    ")?;
                StrUtil.append(mut out, Bridge.cTypeForAbi(structs[i].fields[j].abiKind.view()))?;
                StrUtil.append(mut out, " ")?;
                StrUtil.append(mut out, structs[i].fields[j].name.view())?;
                StrUtil.append(mut out, ";\n")?;
            }
            StrUtil.append(mut out, "} ")?;
            StrUtil.append(mut out, structs[i].name.view())?;
            StrUtil.append(mut out, ";\n\n")?;
        }
        for (i in 0..fns.length) {
            StrUtil.append(mut out, Bridge.cTypeForAbi(fns[i].returnType.view()))?;
            StrUtil.append(mut out, " port_")?;
            StrUtil.append(mut out, pkgName)?;
            StrUtil.append(mut out, "_")?;
            StrUtil.append(mut out, fns[i].name.view())?;
            StrUtil.append(mut out, "(")?;
            if (fns[i].params.length == 0) {
                StrUtil.append(mut out, "void")?;
            } else {
                for (j in 0..fns[i].params.length) {
                    if (j > 0) { StrUtil.append(mut out, ", ")?; }
                    let k = fns[i].params[j].abiKind.view();
                    let pn = fns[i].params[j].name.view();
                    if (k == "bytes") {
                        StrUtil.append(mut out, "const uint8_t *")?;
                        StrUtil.append(mut out, pn)?;
                        StrUtil.append(mut out, "_ptr, size_t ")?;
                        StrUtil.append(mut out, pn)?;
                        StrUtil.append(mut out, "_len")?;
                    } else if (k == "buffer") {
                        StrUtil.append(mut out, "uint8_t *")?;
                        StrUtil.append(mut out, pn)?;
                        StrUtil.append(mut out, "_ptr, size_t ")?;
                        StrUtil.append(mut out, pn)?;
                        StrUtil.append(mut out, "_len")?;
                    } else if (k == "cstr") {
                        StrUtil.append(mut out, "const char *")?;
                        StrUtil.append(mut out, pn)?;
                        StrUtil.append(mut out, "_ptr")?;
                    } else if (StrUtil.startsWith(k, "struct_ptr:")) {
                        StrUtil.append(mut out, "const ")?;
                        StrUtil.append(mut out, k[11..k.bytes().length])?;
                        StrUtil.append(mut out, " *")?;
                        StrUtil.append(mut out, pn)?;
                    } else if (StrUtil.startsWith(k, "enum:")) {
                        StrUtil.append(mut out, k[5..k.bytes().length])?;
                        StrUtil.append(mut out, " ")?;
                        StrUtil.append(mut out, pn)?;
                    } else {
                        StrUtil.append(mut out, Bridge.cTypeForAbi(k))?;
                        StrUtil.append(mut out, " ")?;
                        StrUtil.append(mut out, pn)?;
                    }
                }
            }
            StrUtil.append(mut out, ");\n")?;
        }
        StrUtil.append(mut out, "\n#endif\n")?;
        return Ok(out);
    }

    public fn buildReadme(unit: StringView, pkgName: StringView) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "# ")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, "\n\nCeeSafe port of `")?;
        StrUtil.append(mut out, unit)?;
        StrUtil.append(mut out, "`, generated by `ceesafe-anything`.\n\n## Loop\n\n```sh\n")?;
        StrUtil.append(mut out, "ceesafe-anything record .\nceesafec check --deny-warnings\nceesafec test\n")?;
        StrUtil.append(mut out, "ceesafe-anything build .\nceesafe-anything diff .\nceesafe-anything gate .\n```\n")?;
        return Ok(out);
    }

    public fn run(root: StringView, unit: StringView, outOpt: StringView?) -> Result<String, AppError> {
        let stem = StrUtil.stem(unit);
        let pkgName = StrUtil.sanitizeIdent(stem)?;
        let outDir = match (outOpt) {
            Some(p) => StrUtil.cloneView(p)?,
            null => {
                let ceesafeDir = StrUtil.joinPath(root, "ceesafe")?;
                FsUtil.ensureDir(ceesafeDir.view())?;
                StrUtil.joinPath(ceesafeDir.view(), pkgName.view())?
            }
        };
        let manifestPath = StrUtil.joinPath(outDir.view(), "ceesafe-anything.json")?;
        if (FsUtil.fileExists(manifestPath.view())) {
            return Err(AppError.AlreadyExists);
        }

        let unitPath = StrUtil.joinPath(root, unit)?;
        let lang = Harness.detectUnitLang(unit);
        var structs = Vector<StructSpec>.create();
        var enums = Vector<EnumSpec>.create();
        let extracted = match (FsUtil.readText(unitPath.view())) {
            Ok(src) => {
                if (lang == "c") {
                    structs = Parser.extractCStructs(src.view())?;
                    enums = Parser.extractCEnums(src.view())?;
                }
                Parser.extractFunctions(lang, src.view())?
            }
            Err(_) => Vector<FnSpec>.create(),
        };
        let fns = if (extracted.length > 0) extracted else Bridge.defaultExports()?;

        FsUtil.ensureDir(outDir.view())?;
        let srcDir = StrUtil.joinPath(outDir.view(), "src")?;
        FsUtil.ensureDir(srcDir.view())?;
        let incDir = StrUtil.joinPath(outDir.view(), "include")?;
        FsUtil.ensureDir(incDir.view())?;

        let tomlPath = StrUtil.joinPath(outDir.view(), "ceesafe.toml")?;
        FsUtil.writeText(tomlPath.view(), Bridge.buildCeesafeToml(pkgName.view())?.view())?;

        if (structs.length > 0 || enums.length > 0) {
            let typesPath = StrUtil.joinPath(srcDir.view(), "types.cee")?;
            FsUtil.writeText(typesPath.view(), Bridge.buildTypesCee(structs, enums)?.view())?;
        }

        let portPath = StrUtil.joinPath(srcDir.view(), "port.cee")?;
        FsUtil.writeText(portPath.view(), Bridge.buildPortCee(unit, pkgName.view(), fns)?.view())?;

        let bridgePath = StrUtil.joinPath(srcDir.view(), "bridge.cee")?;
        FsUtil.writeText(bridgePath.view(), Bridge.buildBridgeCee(unit, pkgName.view(), fns)?.view())?;

        var hdrName = StrUtil.cloneView(pkgName.view())?;
        StrUtil.append(mut hdrName, ".h")?;
        let hdrPath = StrUtil.joinPath(incDir.view(), hdrName.view())?;
        FsUtil.writeText(hdrPath.view(), Bridge.buildHeader(unit, pkgName.view(), fns, structs, enums)?.view())?;

        let gitignorePath = StrUtil.joinPath(outDir.view(), ".gitignore")?;
        FsUtil.writeText(gitignorePath.view(), "out/\n.ceesafe-anything/\n")?;

        let readmePath = StrUtil.joinPath(outDir.view(), "README.md")?;
        FsUtil.writeText(readmePath.view(), Bridge.buildReadme(unit, pkgName.view())?.view())?;

        let manifestText = Bridge.buildManifestJson(root, unit, pkgName.view(), fns, structs, enums)?;
        FsUtil.writeText(manifestPath.view(), manifestText.view())?;

        var summary = String.create();
        StrUtil.append(mut summary, "Scaffolded CeeSafe package at ")?;
        StrUtil.append(mut summary, outDir.view())?;
        StrUtil.append(mut summary, " (")?;
        StrUtil.appendNum(mut summary, fns.length as u64)?;
        StrUtil.append(mut summary, " exported function(s))\n")?;
        for (i in 0..fns.length) {
            StrUtil.append(mut summary, "  fn ")?;
            StrUtil.append(mut summary, fns[i].name.view())?;
            StrUtil.append(mut summary, " -> port_")?;
            StrUtil.append(mut summary, pkgName.view())?;
            StrUtil.append(mut summary, "_")?;
            StrUtil.append(mut summary, fns[i].name.view())?;
            StrUtil.append(mut summary, "\n")?;
        }
        return Ok(summary);
    }

    public fn refresh(pkgDir: StringView) -> Result<String, AppError> {
        let manifestPath = StrUtil.joinPath(pkgDir, "ceesafe-anything.json")?;
        let manifestText = FsUtil.readText(manifestPath.view())?;
        let root = match (StrUtil.jsonStringField(manifestText.view(), "root")?) {
            Some(r) => r,
            null => { return Err(AppError.InvalidArg); },
        };
        let unit = match (StrUtil.jsonStringField(manifestText.view(), "unit")?) {
            Some(u) => u,
            null => { return Err(AppError.InvalidArg); },
        };
        let pkgName = match (StrUtil.jsonStringField(manifestText.view(), "package_name")?) {
            Some(n) => n,
            null => StrUtil.cloneView("port")?,
        };

        let unitPath = StrUtil.joinPath(root.view(), unit.view())?;
        let lang = Harness.detectUnitLang(unit.view());
        var structs = Vector<StructSpec>.create();
        var enums = Vector<EnumSpec>.create();
        let extracted = match (FsUtil.readText(unitPath.view())) {
            Ok(src) => {
                if (lang == "c") {
                    structs = Parser.extractCStructs(src.view())?;
                    enums = Parser.extractCEnums(src.view())?;
                }
                Parser.extractFunctions(lang, src.view())?
            }
            Err(_) => Vector<FnSpec>.create(),
        };
        let fns = if (extracted.length > 0) extracted else Bridge.defaultExports()?;

        let srcDir = StrUtil.joinPath(pkgDir, "src")?;
        FsUtil.ensureDir(srcDir.view())?;
        let incDir = StrUtil.joinPath(pkgDir, "include")?;
        FsUtil.ensureDir(incDir.view())?;

        if (structs.length > 0 || enums.length > 0) {
            let typesPath = StrUtil.joinPath(srcDir.view(), "types.cee")?;
            FsUtil.writeText(typesPath.view(), Bridge.buildTypesCee(structs, enums)?.view())?;
        }

        let bridgePath = StrUtil.joinPath(srcDir.view(), "bridge.cee")?;
        FsUtil.writeText(bridgePath.view(), Bridge.buildBridgeCee(unit.view(), pkgName.view(), fns)?.view())?;

        var hdrName = StrUtil.cloneView(pkgName.view())?;
        StrUtil.append(mut hdrName, ".h")?;
        let hdrPath = StrUtil.joinPath(incDir.view(), hdrName.view())?;
        FsUtil.writeText(hdrPath.view(), Bridge.buildHeader(unit.view(), pkgName.view(), fns, structs, enums)?.view())?;

        let newManifest = Bridge.buildManifestJson(root.view(), unit.view(), pkgName.view(), fns, structs, enums)?;
        FsUtil.writeText(manifestPath.view(), newManifest.view())?;

        var summary = String.create();
        StrUtil.append(mut summary, "Refreshed ")?;
        StrUtil.append(mut summary, pkgDir)?;
        StrUtil.append(mut summary, " (")?;
        StrUtil.appendNum(mut summary, fns.length as u64)?;
        StrUtil.append(mut summary, " exported function(s); src/port.cee untouched)\n")?;
        return Ok(summary);
    }
}
