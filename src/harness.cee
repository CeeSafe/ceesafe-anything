// `build`, `record`, and `diff`: compile CeeSafe C-ABI shared libraries and run multi-function
// isolated differential tests across C, Python, and TypeScript/JavaScript source units.

public struct Harness {
    public fn detectUnitLang(unit: StringView) -> StringView {
        if (StrUtil.endsWith(unit, ".py")) {
            return "python";
        }
        if (StrUtil.endsWith(unit, ".ts") || StrUtil.endsWith(unit, ".tsx") ||
            StrUtil.endsWith(unit, ".js") || StrUtil.endsWith(unit, ".mjs")) {
            return "ts";
        }
        if (StrUtil.endsWith(unit, ".go")) {
            return "go";
        }
        return "c";
    }

    fn collectCFiles(dir: StringView, out: borrow mut Vector<String>) -> Result<void, AppError> {
        let entries = match (Directory.list(dir)) {
            Ok(list) => list,
            Err(_) => { return Ok(); },
        };
        for (i in 0..entries.length) {
            let name = entries[i].view();
            let full = StrUtil.joinPath(dir, name)?;
            if (StrUtil.endsWith(name, ".c")) {
                match (out.push(full)) {
                    Ok() => {}
                    Err(_) => { return Err(AppError.OutOfMemory); }
                }
            } else if (!StrUtil.contains(name, ".")) {
                Harness.collectCFiles(full.view(), mut out)?;
            }
        }
        return Ok();
    }

    public fn driverScript() -> Result<String, AppError> {
        var s = String.create();
        StrUtil.append(mut s, "import ctypes, json, os, signal, sys\n\n")?;
        StrUtil.append(mut s, "CTYPES_MAP = {\n")?;
        StrUtil.append(mut s, "    'i32': ctypes.c_int32, 'u32': ctypes.c_uint32,\n")?;
        StrUtil.append(mut s, "    'i64': ctypes.c_int64, 'u64': ctypes.c_uint64,\n")?;
        StrUtil.append(mut s, "    'usize': ctypes.c_size_t, 'f64': ctypes.c_double,\n")?;
        StrUtil.append(mut s, "    'bool': ctypes.c_bool, 'void': None,\n")?;
        StrUtil.append(mut s, "}\n\n")?;
        StrUtil.append(mut s, "SAMPLES = {\n")?;
        StrUtil.append(mut s, "    'bytes': ['', 'hello', 'hello world 123', 'caf\\u00e9 \\u2603', 'a' * 128],\n")?;
        StrUtil.append(mut s, "    'i32': [0, 1, -1, 42, -42, 1000],\n")?;
        StrUtil.append(mut s, "    'i64': [0, 1, -1, 42, -100000],\n")?;
        StrUtil.append(mut s, "    'u32': [0, 1, 42, 1000],\n")?;
        StrUtil.append(mut s, "    'u64': [0, 1, 42, 100000],\n")?;
        StrUtil.append(mut s, "    'usize': [0, 1, 16, 256],\n")?;
        StrUtil.append(mut s, "    'f64': [0.0, 1.5, -3.25, 100.0],\n")?;
        StrUtil.append(mut s, "    'bool': [False, True],\n")?;
        StrUtil.append(mut s, "}\n\n")?;
        StrUtil.append(mut s, "def gen_cases(exports):\n")?;
        StrUtil.append(mut s, "    out = []\n")?;
        StrUtil.append(mut s, "    for exp in exports:\n")?;
        StrUtil.append(mut s, "        params = exp.get('params', [])\n")?;
        StrUtil.append(mut s, "        if not params:\n")?;
        StrUtil.append(mut s, "            out.append({'fn': exp['name'], 'symbol': exp['symbol'], 'args': []})\n")?;
        StrUtil.append(mut s, "            continue\n")?;
        StrUtil.append(mut s, "        pools = [SAMPLES.get(p['kind'], [0, 1]) for p in params]\n")?;
        StrUtil.append(mut s, "        n = max(len(p) for p in pools)\n")?;
        StrUtil.append(mut s, "        for i in range(n):\n")?;
        StrUtil.append(mut s, "            args = [pool[i % len(pool)] for pool in pools]\n")?;
        StrUtil.append(mut s, "            out.append({'fn': exp['name'], 'symbol': exp['symbol'], 'args': args})\n")?;
        StrUtil.append(mut s, "    return out\n\n")?;
        StrUtil.append(mut s, "def call_fn(lib, sym_name, spec, args):\n")?;
        StrUtil.append(mut s, "    fn = getattr(lib, sym_name)\n")?;
        StrUtil.append(mut s, "    argtypes, c_args = [], []\n")?;
        StrUtil.append(mut s, "    for p, val in zip(spec.get('params', []), args):\n")?;
        StrUtil.append(mut s, "        k = p['kind']\n")?;
        StrUtil.append(mut s, "        if k == 'bytes':\n")?;
        StrUtil.append(mut s, "            data = str(val).encode('utf-8')\n")?;
        StrUtil.append(mut s, "            argtypes.extend([ctypes.c_char_p, ctypes.c_size_t])\n")?;
        StrUtil.append(mut s, "            c_args.extend([data, len(data)])\n")?;
        StrUtil.append(mut s, "        elif k == 'f64':\n")?;
        StrUtil.append(mut s, "            argtypes.append(ctypes.c_double)\n")?;
        StrUtil.append(mut s, "            c_args.append(float(val))\n")?;
        StrUtil.append(mut s, "        elif k == 'bool':\n")?;
        StrUtil.append(mut s, "            argtypes.append(ctypes.c_bool)\n")?;
        StrUtil.append(mut s, "            c_args.append(bool(val))\n")?;
        StrUtil.append(mut s, "        else:\n")?;
        StrUtil.append(mut s, "            argtypes.append(CTYPES_MAP.get(k, ctypes.c_int32))\n")?;
        StrUtil.append(mut s, "            c_args.append(int(val))\n")?;
        StrUtil.append(mut s, "    fn.argtypes = argtypes\n")?;
        StrUtil.append(mut s, "    ret_k = spec.get('return', 'i32')\n")?;
        StrUtil.append(mut s, "    fn.restype = CTYPES_MAP.get(ret_k, ctypes.c_int32)\n")?;
        StrUtil.append(mut s, "    res = fn(*c_args)\n")?;
        StrUtil.append(mut s, "    if ret_k == 'void': return {'ok': None}\n")?;
        StrUtil.append(mut s, "    if ret_k == 'f64': return {'ok': float(res)}\n")?;
        StrUtil.append(mut s, "    if ret_k == 'bool': return {'ok': bool(res)}\n")?;
        StrUtil.append(mut s, "    return {'ok': int(res)}\n\n")?;
        StrUtil.append(mut s, "def isolated(lib, sym_name, spec, args):\n")?;
        StrUtil.append(mut s, "    r, w = os.pipe()\n")?;
        StrUtil.append(mut s, "    pid = os.fork()\n")?;
        StrUtil.append(mut s, "    if pid == 0:\n")?;
        StrUtil.append(mut s, "        os.close(r)\n")?;
        StrUtil.append(mut s, "        try:\n")?;
        StrUtil.append(mut s, "            res = call_fn(lib, sym_name, spec, args)\n")?;
        StrUtil.append(mut s, "        except Exception as e:\n")?;
        StrUtil.append(mut s, "            res = {'error': f'{type(e).__name__}: {e}'}\n")?;
        StrUtil.append(mut s, "        os.write(w, json.dumps(res).encode('utf-8'))\n")?;
        StrUtil.append(mut s, "        os._exit(0)\n")?;
        StrUtil.append(mut s, "    os.close(w)\n")?;
        StrUtil.append(mut s, "    buf = b''\n")?;
        StrUtil.append(mut s, "    while True:\n")?;
        StrUtil.append(mut s, "        chunk = os.read(r, 65536)\n")?;
        StrUtil.append(mut s, "        if not chunk: break\n")?;
        StrUtil.append(mut s, "        buf += chunk\n")?;
        StrUtil.append(mut s, "    os.close(r)\n")?;
        StrUtil.append(mut s, "    _, status = os.waitpid(pid, 0)\n")?;
        StrUtil.append(mut s, "    if os.WIFSIGNALED(status):\n")?;
        StrUtil.append(mut s, "        return {'error': 'crash: ' + signal.Signals(os.WTERMSIG(status)).name}\n")?;
        StrUtil.append(mut s, "    return json.loads(buf) if buf else {'error': 'crash: no result'}\n\n")?;
        StrUtil.append(mut s, "mode = sys.argv[1]\n")?;
        StrUtil.append(mut s, "lib_path, manifest_path, cases_path = sys.argv[2], sys.argv[3], sys.argv[4]\n")?;
        StrUtil.append(mut s, "manifest = json.load(open(manifest_path, encoding='utf-8'))\n")?;
        StrUtil.append(mut s, "exports = manifest.get('exports', [])\n")?;
        StrUtil.append(mut s, "by_name = {e['name']: e for e in exports}\n")?;
        StrUtil.append(mut s, "lib = ctypes.CDLL(lib_path)\n")?;
        StrUtil.append(mut s, "if mode == 'record':\n")?;
        StrUtil.append(mut s, "    inputs_path = sys.argv[5] if len(sys.argv) > 5 and sys.argv[5] else ''\n")?;
        StrUtil.append(
            mut s,
            "    cases = [json.loads(l) for l in open(inputs_path) if l.strip()] if inputs_path else gen_cases(exports)\n",
        )?;
        StrUtil.append(mut s, "    with open(cases_path, 'w', encoding='utf-8') as out:\n")?;
        StrUtil.append(mut s, "        for c in cases:\n")?;
        StrUtil.append(mut s, "            spec = by_name[c['fn']]\n")?;
        StrUtil.append(mut s, "            rec = {'fn': c['fn'], 'symbol': spec['symbol'], 'args': c['args']}\n")?;
        StrUtil.append(mut s, "            rec.update(isolated(lib, c['fn'], spec, c['args']))\n")?;
        StrUtil.append(mut s, "            out.write(json.dumps(rec, ensure_ascii=False) + '\\n')\n")?;
        StrUtil.append(mut s, "    print(f'recorded {len(cases)} cases to {cases_path}')\n")?;
        StrUtil.append(mut s, "elif mode == 'diff':\n")?;
        StrUtil.append(mut s, "    out_json = sys.argv[5]\n")?;
        StrUtil.append(
            mut s,
            "    cases = [json.loads(l) for l in open(cases_path, encoding='utf-8') if l.strip()]\n",
        )?;
        StrUtil.append(mut s, "    passed, failed, mismatches = 0, 0, []\n")?;
        StrUtil.append(mut s, "    for c in cases:\n")?;
        StrUtil.append(mut s, "        spec = by_name.get(c['fn'])\n")?;
        StrUtil.append(mut s, "        if not spec:\n")?;
        StrUtil.append(mut s, "            failed += 1\n")?;
        StrUtil.append(mut s, "            mismatches.append({'fn': c['fn'], 'error': 'unknown export'})\n")?;
        StrUtil.append(mut s, "            continue\n")?;
        StrUtil.append(mut s, "        if str(c.get('error', '')).startswith('crash:'):\n")?;
        StrUtil.append(mut s, "            passed += 1\n")?;
        StrUtil.append(mut s, "            continue\n")?;
        StrUtil.append(mut s, "        sym = c.get('symbol', spec['symbol'])\n")?;
        StrUtil.append(mut s, "        got = isolated(lib, sym, spec, c['args'])\n")?;
        StrUtil.append(mut s, "        exp = {'error': c['error']} if 'error' in c else {'ok': c.get('ok')}\n")?;
        StrUtil.append(mut s, "        if json.dumps(got, sort_keys=True) == json.dumps(exp, sort_keys=True):\n")?;
        StrUtil.append(mut s, "            passed += 1\n")?;
        StrUtil.append(mut s, "        else:\n")?;
        StrUtil.append(mut s, "            failed += 1\n")?;
        StrUtil.append(
            mut s,
            "            mismatches.append({'fn': c['fn'], 'symbol': sym, 'args': c['args'], 'expected': exp, 'actual': got})\n",
        )?;
        StrUtil.append(
            mut s,
            "    summary = {'total': len(cases), 'passed': passed, 'failed': failed, 'mismatches': mismatches}\n",
        )?;
        StrUtil.append(mut s, "    json.dump(summary, open(out_json, 'w', encoding='utf-8'), indent=2)\n")?;
        StrUtil.append(mut s, "    print(f'{passed}/{len(cases)} cases matched ({failed} failed)')\n")?;
        StrUtil.append(mut s, "    sys.exit(0 if failed == 0 else 1)\n")?;
        return Ok(s);
    }

    public fn pyRecordScript() -> Result<String, AppError> {
        var s = String.create();
        StrUtil.append(mut s, "import importlib.util, json, sys\n\n")?;
        StrUtil.append(
            mut s,
            "SAMPLES = {'bytes': ['', 'hello', 'caf\\u00e9 \\u2603'], 'i32': [0, 1, -1, 42], 'i64': [0, 1, -1, 42], 'u32': [0, 1, 42], 'f64': [0.0, 1.5, -3.25], 'bool': [False, True]}\n\n",
        )?;
        StrUtil.append(mut s, "unit_path, manifest_path, cases_path = sys.argv[1], sys.argv[2], sys.argv[3]\n")?;
        StrUtil.append(mut s, "inputs_path = sys.argv[4] if len(sys.argv) > 4 and sys.argv[4] else ''\n")?;
        StrUtil.append(mut s, "manifest = json.load(open(manifest_path, encoding='utf-8'))\n")?;
        StrUtil.append(mut s, "exports = manifest.get('exports', [])\n")?;
        StrUtil.append(mut s, "by_name = {e['name']: e for e in exports}\n")?;
        StrUtil.append(mut s, "spec = importlib.util.spec_from_file_location('orig_unit', unit_path)\n")?;
        StrUtil.append(mut s, "mod = importlib.util.module_from_spec(spec)\n")?;
        StrUtil.append(mut s, "spec.loader.exec_module(mod)\n")?;
        StrUtil.append(mut s, "if inputs_path:\n")?;
        StrUtil.append(mut s, "    cases = [json.loads(l) for l in open(inputs_path) if l.strip()]\n")?;
        StrUtil.append(mut s, "else:\n")?;
        StrUtil.append(mut s, "    cases = []\n")?;
        StrUtil.append(mut s, "    for exp in exports:\n")?;
        StrUtil.append(mut s, "        pools = [SAMPLES.get(p['kind'], [0, 1]) for p in exp.get('params', [])]\n")?;
        StrUtil.append(mut s, "        n = max((len(p) for p in pools), default=1)\n")?;
        StrUtil.append(mut s, "        for i in range(n):\n")?;
        StrUtil.append(
            mut s,
            "            cases.append({'fn': exp['name'], 'args': [pool[i % len(pool)] for pool in pools]})\n",
        )?;
        StrUtil.append(mut s, "with open(cases_path, 'w', encoding='utf-8') as out:\n")?;
        StrUtil.append(mut s, "    for c in cases:\n")?;
        StrUtil.append(mut s, "        exp = by_name[c['fn']]\n")?;
        StrUtil.append(mut s, "        rec = {'fn': c['fn'], 'symbol': exp['symbol'], 'args': c['args']}\n")?;
        StrUtil.append(mut s, "        try:\n")?;
        StrUtil.append(mut s, "            rec['ok'] = getattr(mod, c['fn'])(*c['args'])\n")?;
        StrUtil.append(mut s, "        except Exception as e:\n")?;
        StrUtil.append(mut s, "            rec['error'] = f'{type(e).__name__}: {e}'\n")?;
        StrUtil.append(mut s, "        out.write(json.dumps(rec, ensure_ascii=False) + '\\n')\n")?;
        return Ok(s);
    }

    public fn nodeRecordScript() -> Result<String, AppError> {
        var s = String.create();
        StrUtil.append(mut s, "import fs from 'node:fs';\n")?;
        StrUtil.append(mut s, "import { pathToFileURL } from 'node:url';\n\n")?;
        StrUtil.append(
            mut s,
            "const SAMPLES = { bytes: ['', 'hello', 'caf\\u00e9 \\u2603'], i32: [0, 1, -1, 42], i64: [0, 1, -1, 42], u32: [0, 1, 42], f64: [0.0, 1.5, -3.25], bool: [false, true] };\n",
        )?;
        StrUtil.append(mut s, "const [unitPath, manifestPath, casesPath, inputsPath] = process.argv.slice(2);\n")?;
        StrUtil.append(mut s, "const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));\n")?;
        StrUtil.append(mut s, "const exports = manifest.exports || [];\n")?;
        StrUtil.append(mut s, "const byName = Object.fromEntries(exports.map(e => [e.name, e]));\n")?;
        StrUtil.append(mut s, "const mod = await import(pathToFileURL(unitPath).href);\n")?;
        StrUtil.append(mut s, "let cases = [];\n")?;
        StrUtil.append(mut s, "if (inputsPath) {\n")?;
        StrUtil.append(
            mut s,
            "  cases = fs.readFileSync(inputsPath, 'utf8').split('\\n').filter(Boolean).map(JSON.parse);\n",
        )?;
        StrUtil.append(mut s, "} else {\n")?;
        StrUtil.append(mut s, "  for (const exp of exports) {\n")?;
        StrUtil.append(mut s, "    const pools = (exp.params || []).map(p => SAMPLES[p.kind] || [0, 1]);\n")?;
        StrUtil.append(mut s, "    const n = pools.length ? Math.max(...pools.map(p => p.length)) : 1;\n")?;
        StrUtil.append(
            mut s,
            "    for (let i = 0; i < n; i++) cases.push({ fn: exp.name, args: pools.map(p => p[i % p.length]) });\n",
        )?;
        StrUtil.append(mut s, "  }\n")?;
        StrUtil.append(mut s, "}\n")?;
        StrUtil.append(mut s, "const lines = [];\n")?;
        StrUtil.append(mut s, "for (const c of cases) {\n")?;
        StrUtil.append(mut s, "  const exp = byName[c.fn];\n")?;
        StrUtil.append(mut s, "  const rec = { fn: c.fn, symbol: exp.symbol, args: c.args };\n")?;
        StrUtil.append(
            mut s,
            "  try { rec.ok = await mod[c.fn](...c.args); } catch (e) { rec.error = `${e?.name || 'Error'}: ${e?.message || String(e)}`; }\n",
        )?;
        StrUtil.append(mut s, "  lines.push(JSON.stringify(rec));\n")?;
        StrUtil.append(mut s, "}\n")?;
        StrUtil.append(mut s, "fs.writeFileSync(casesPath, lines.join('\\n') + '\\n', 'utf8');\n")?;
        return Ok(s);
    }

    fn writeDriver(pkgDir: StringView) -> Result<String, AppError> {
        let workDir = StrUtil.joinPath(pkgDir, ".ceesafe-anything")?;
        FsUtil.ensureDir(workDir.view())?;
        let driverPath = StrUtil.joinPath(workDir.view(), "driver.py")?;
        let script = Harness.driverScript()?;
        FsUtil.writeText(driverPath.view(), script.view())?;
        return Ok(driverPath);
    }

    public fn build(pkgDir: StringView) -> Result<String, AppError> {
        let manifestPath = StrUtil.joinPath(pkgDir, "ceesafe-anything.json")?;
        let manifestText = FsUtil.readText(manifestPath.view())?;
        let pkgName = match (StrUtil.jsonStringField(manifestText.view(), "package_name")?) {
            Some(n) => n,
            null => StrUtil.cloneView("port")?,
        };

        let workDir = StrUtil.joinPath(pkgDir, ".ceesafe-anything")?;
        FsUtil.ensureDir(workDir.view())?;
        let cDir = StrUtil.joinPath(workDir.view(), "c")?;
        FsUtil.ensureDir(cDir.view())?;
        let outDir = StrUtil.joinPath(pkgDir, "out")?;
        FsUtil.ensureDir(outDir.view())?;

        var emitArgs = Vector<StringView>.create();
        match (emitArgs.push("-c")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (emitArgs.push("cd \"$1\" && exec ceesafec build --emit c -o \"$2\"")) {
            Ok() => {}
            Err(_) => { return Err(AppError.OutOfMemory); }
        }
        match (emitArgs.push("_")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (emitArgs.push(pkgDir)) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (emitArgs.push(cDir.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }

        let emitted = match (Process.capture("/bin/sh", emitArgs, null)) {
            Ok(out) => out,
            Err(e) => { return Err(AppErrors.fromIo(e)); },
        };
        if (emitted.status != 0) {
            return Err(AppError.CommandFailed);
        }

        var cFiles = Vector<String>.create();
        Harness.collectCFiles(cDir.view(), mut cFiles)?;
        if (cFiles.length == 0) {
            return Err(AppError.NotFound);
        }

        var libFile = String.create();
        StrUtil.append(mut libFile, "lib")?;
        StrUtil.append(mut libFile, pkgName.view())?;
        StrUtil.append(mut libFile, ".dylib")?;
        let libPath = StrUtil.joinPath(outDir.view(), libFile.view())?;

        var ccArgs = Vector<StringView>.create();
        match (ccArgs.push("-shared")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (ccArgs.push("-fPIC")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (ccArgs.push("-O2")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (ccArgs.push("-w")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (ccArgs.push("-I")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (ccArgs.push(cDir.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (ccArgs.push("-o")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (ccArgs.push(libPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        for (i in 0..cFiles.length) {
            match (ccArgs.push(cFiles[i].view())) {
                Ok() => {}
                Err(_) => { return Err(AppError.OutOfMemory); }
            }
        }
        match (ccArgs.push("-lm")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }

        let linked = match (Process.capture("cc", ccArgs, null)) {
            Ok(out) => out,
            Err(e) => { return Err(AppErrors.fromIo(e)); },
        };
        if (linked.status != 0) {
            return Err(AppError.CommandFailed);
        }
        return Ok(libPath);
    }

    public fn record(pkgDir: StringView, inputsOpt: StringView?) -> Result<String, AppError> {
        let manifestPath = StrUtil.joinPath(pkgDir, "ceesafe-anything.json")?;
        let manifestText = FsUtil.readText(manifestPath.view())?;
        let root = match (StrUtil.jsonStringField(manifestText.view(), "root")?) {
            Some(r) => r,
            null => { return Err(AppError.InvalidArg); },
        };
        let unit = match (StrUtil.jsonStringField(manifestText.view(), "unit")?) {
            Some(u) => u,
            null => { return Err(AppError.InvalidArg); },
        };

        let unitPath = StrUtil.joinPath(root.view(), unit.view())?;
        let workDir = StrUtil.joinPath(pkgDir, ".ceesafe-anything")?;
        FsUtil.ensureDir(workDir.view())?;
        let casesPath = StrUtil.joinPath(pkgDir, "cases.jsonl")?;

        let lang = Harness.detectUnitLang(unit.view());
        if (lang == "python") {
            let pyScriptPath = StrUtil.joinPath(workDir.view(), "record_py.py")?;
            let script = Harness.pyRecordScript()?;
            FsUtil.writeText(pyScriptPath.view(), script.view())?;
            var args = Vector<StringView>.create();
            match (args.push(pyScriptPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
            match (args.push(unitPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
            match (args.push(manifestPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
            match (args.push(casesPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
            match (inputsOpt) {
                Some(inp) => {
                    match (args.push(inp)) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
                }
                null => {}
            }
            let ran = match (Process.capture("python3", args, null)) {
                Ok(out) => out,
                Err(e) => { return Err(AppErrors.fromIo(e)); },
            };
            if (ran.status != 0) {
                return Err(AppError.CommandFailed);
            }
            return Ok(casesPath);
        }

        if (lang == "ts") {
            let jsScriptPath = StrUtil.joinPath(workDir.view(), "record_js.mjs")?;
            let script = Harness.nodeRecordScript()?;
            FsUtil.writeText(jsScriptPath.view(), script.view())?;
            var args = Vector<StringView>.create();
            match (args.push(jsScriptPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
            match (args.push(unitPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
            match (args.push(manifestPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
            match (args.push(casesPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
            match (inputsOpt) {
                Some(inp) => {
                    match (args.push(inp)) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
                }
                null => {}
            }
            let ran = match (Process.capture("node", args, null)) {
                Ok(out) => out,
                Err(e) => { return Err(AppErrors.fromIo(e)); },
            };
            if (ran.status != 0) {
                return Err(AppError.CommandFailed);
            }
            return Ok(casesPath);
        }

        // Default C source unit: compile to original.dylib and record via isolated ctypes
        let origLib = StrUtil.joinPath(workDir.view(), "original.dylib")?;
        var ccArgs = Vector<StringView>.create();
        match (ccArgs.push("-shared")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (ccArgs.push("-fPIC")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (ccArgs.push("-O1")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (ccArgs.push("-w")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (ccArgs.push("-o")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (ccArgs.push(origLib.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (ccArgs.push(unitPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (ccArgs.push("-lm")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }

        let built = match (Process.capture("cc", ccArgs, null)) {
            Ok(out) => out,
            Err(e) => { return Err(AppErrors.fromIo(e)); },
        };
        if (built.status != 0) {
            return Err(AppError.CommandFailed);
        }

        let driverPath = Harness.writeDriver(pkgDir)?;
        var pyArgs = Vector<StringView>.create();
        match (pyArgs.push(driverPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (pyArgs.push("record")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (pyArgs.push(origLib.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (pyArgs.push(manifestPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (pyArgs.push(casesPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (inputsOpt) {
            Some(inp) => {
                match (pyArgs.push(inp)) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
            }
            null => {}
        }

        let ran = match (Process.capture("python3", pyArgs, null)) {
            Ok(out) => out,
            Err(e) => { return Err(AppErrors.fromIo(e)); },
        };
        if (ran.status != 0) {
            return Err(AppError.CommandFailed);
        }
        return Ok(casesPath);
    }

    public fn diff(pkgDir: StringView) -> Result<bool, AppError> {
        let casesPath = StrUtil.joinPath(pkgDir, "cases.jsonl")?;
        if (!FsUtil.fileExists(casesPath.view())) {
            return Err(AppError.NotFound);
        }
        let manifestPath = StrUtil.joinPath(pkgDir, "ceesafe-anything.json")?;
        let manifestText = FsUtil.readText(manifestPath.view())?;
        let pkgName = match (StrUtil.jsonStringField(manifestText.view(), "package_name")?) {
            Some(n) => n,
            null => StrUtil.cloneView("port")?,
        };

        var libFile = String.create();
        StrUtil.append(mut libFile, "lib")?;
        StrUtil.append(mut libFile, pkgName.view())?;
        StrUtil.append(mut libFile, ".dylib")?;
        let outDir = StrUtil.joinPath(pkgDir, "out")?;
        let libPath = StrUtil.joinPath(outDir.view(), libFile.view())?;
        if (!FsUtil.fileExists(libPath.view())) {
            let _ = Harness.build(pkgDir)?;
        }

        let driverPath = Harness.writeDriver(pkgDir)?;
        let workDir = StrUtil.joinPath(pkgDir, ".ceesafe-anything")?;
        let diffJson = StrUtil.joinPath(workDir.view(), "diff.json")?;

        var pyArgs = Vector<StringView>.create();
        match (pyArgs.push(driverPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (pyArgs.push("diff")) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (pyArgs.push(libPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (pyArgs.push(manifestPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (pyArgs.push(casesPath.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }
        match (pyArgs.push(diffJson.view())) { Ok() => {} Err(_) => { return Err(AppError.OutOfMemory); } }

        let ran = match (Process.capture("python3", pyArgs, null)) {
            Ok(out) => out,
            Err(e) => { return Err(AppErrors.fromIo(e)); },
        };
        return Ok(ran.status == 0);
    }
}
