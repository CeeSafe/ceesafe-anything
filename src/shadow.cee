// `shadow`: generate a drop-in C shadow wrapper (`shadow/<pkg>_shadow.c` + `shadow/flags.txt`)
// that runs the original C function (compiled with `-D<fn>=<fn>__original`) and the CeeSafe port
// side by side, logs mismatches to stderr, and always returns the original's result.

public struct Shadow {
    fn cType(abi: StringView) -> StringView {
        if (abi == "u32") { return "uint32_t"; }
        if (abi == "i64") { return "int64_t"; }
        if (abi == "u64") { return "uint64_t"; }
        if (abi == "usize") { return "size_t"; }
        if (abi == "f64") { return "double"; }
        if (abi == "bool") { return "bool"; }
        if (abi == "void") { return "void"; }
        return "int32_t";
    }

    fn appendParams(dst: borrow mut String, params: borrow Vector<ParamSpec>) -> Result<void, AppError> {
        if (params.length == 0) {
            StrUtil.append(mut dst, "void")?;
            return Ok();
        }
        for (j in 0..params.length) {
            if (j > 0) {
                StrUtil.append(mut dst, ", ")?;
            }
            let k = params[j].abiKind.view();
            let pn = params[j].name.view();
            if (k == "bytes") {
                StrUtil.append(mut dst, "const uint8_t *")?;
                StrUtil.append(mut dst, pn)?;
                StrUtil.append(mut dst, "_ptr, size_t ")?;
                StrUtil.append(mut dst, pn)?;
                StrUtil.append(mut dst, "_len")?;
            } else if (k == "buffer") {
                StrUtil.append(mut dst, "uint8_t *")?;
                StrUtil.append(mut dst, pn)?;
                StrUtil.append(mut dst, "_ptr, size_t ")?;
                StrUtil.append(mut dst, pn)?;
                StrUtil.append(mut dst, "_len")?;
            } else if (k == "cstr") {
                StrUtil.append(mut dst, "const char *")?;
                StrUtil.append(mut dst, pn)?;
                StrUtil.append(mut dst, "_ptr")?;
            } else {
                StrUtil.append(mut dst, Shadow.cType(k))?;
                StrUtil.append(mut dst, " ")?;
                StrUtil.append(mut dst, pn)?;
            }
        }
        return Ok();
    }

    fn appendArgs(dst: borrow mut String, params: borrow Vector<ParamSpec>) -> Result<void, AppError> {
        for (j in 0..params.length) {
            if (j > 0) {
                StrUtil.append(mut dst, ", ")?;
            }
            let k = params[j].abiKind.view();
            let pn = params[j].name.view();
            if (k == "bytes" || k == "buffer") {
                StrUtil.append(mut dst, pn)?;
                StrUtil.append(mut dst, "_ptr, ")?;
                StrUtil.append(mut dst, pn)?;
                StrUtil.append(mut dst, "_len")?;
            } else if (k == "cstr") {
                StrUtil.append(mut dst, pn)?;
                StrUtil.append(mut dst, "_ptr")?;
            } else {
                StrUtil.append(mut dst, pn)?;
            }
        }
        return Ok();
    }

    public fn generateFlags(fns: borrow Vector<FnSpec>) -> Result<String, AppError> {
        var out = String.create();
        for (i in 0..fns.length) {
            if (i > 0) {
                StrUtil.append(mut out, " ")?;
            }
            StrUtil.append(mut out, "-D")?;
            StrUtil.append(mut out, fns[i].name.view())?;
            StrUtil.append(mut out, "=")?;
            StrUtil.append(mut out, fns[i].name.view())?;
            StrUtil.append(mut out, "__original")?;
        }
        StrUtil.append(mut out, "\n")?;
        return Ok(out);
    }

    public fn generateC(
        unit: StringView,
        pkgName: StringView,
        fns: borrow Vector<FnSpec>,
    ) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "/* Generated by ceesafe-anything: runs original `")?;
        StrUtil.append(mut out, unit)?;
        StrUtil.append(mut out, "` and the CeeSafe port side by side.\n")?;
        StrUtil.append(
            mut out,
            " * Compile original sources with flags in shadow/flags.txt, then link this file and lib",
        )?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, ". */\n")?;
        StrUtil.append(
            mut out,
            "#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <string.h>\n\n",
        )?;
        StrUtil.append(mut out, "long ceesafe_shadow_calls = 0;\nlong ceesafe_shadow_mismatches = 0;\n\n")?;

        for (i in 0..fns.length) {
            let ret = Shadow.cType(fns[i].returnType.view());
            let name = fns[i].name.view();
            // Prototypes
            StrUtil.append(mut out, ret)?;
            StrUtil.append(mut out, " ")?;
            StrUtil.append(mut out, name)?;
            StrUtil.append(mut out, "__original(")?;
            Shadow.appendParams(mut out, fns[i].params)?;
            StrUtil.append(mut out, ");\n")?;

            StrUtil.append(mut out, ret)?;
            StrUtil.append(mut out, " port_")?;
            StrUtil.append(mut out, pkgName)?;
            StrUtil.append(mut out, "_")?;
            StrUtil.append(mut out, name)?;
            StrUtil.append(mut out, "(")?;
            Shadow.appendParams(mut out, fns[i].params)?;
            StrUtil.append(mut out, ");\n\n")?;

            // Shadow wrapper
            StrUtil.append(mut out, ret)?;
            StrUtil.append(mut out, " ")?;
            StrUtil.append(mut out, name)?;
            StrUtil.append(mut out, "(")?;
            Shadow.appendParams(mut out, fns[i].params)?;
            StrUtil.append(mut out, ") {\n")?;
            if (ret == "void") {
                StrUtil.append(mut out, "    ")?;
                StrUtil.append(mut out, name)?;
                StrUtil.append(mut out, "__original(")?;
                Shadow.appendArgs(mut out, fns[i].params)?;
                StrUtil.append(mut out, ");\n    port_")?;
                StrUtil.append(mut out, pkgName)?;
                StrUtil.append(mut out, "_")?;
                StrUtil.append(mut out, name)?;
                StrUtil.append(mut out, "(")?;
                Shadow.appendArgs(mut out, fns[i].params)?;
                StrUtil.append(mut out, ");\n    ceesafe_shadow_calls++;\n}\n\n")?;
            } else {
                StrUtil.append(mut out, "    ")?;
                StrUtil.append(mut out, ret)?;
                StrUtil.append(mut out, " expected = ")?;
                StrUtil.append(mut out, name)?;
                StrUtil.append(mut out, "__original(")?;
                Shadow.appendArgs(mut out, fns[i].params)?;
                StrUtil.append(mut out, ");\n    ")?;
                StrUtil.append(mut out, ret)?;
                StrUtil.append(mut out, " actual = port_")?;
                StrUtil.append(mut out, pkgName)?;
                StrUtil.append(mut out, "_")?;
                StrUtil.append(mut out, name)?;
                StrUtil.append(mut out, "(")?;
                Shadow.appendArgs(mut out, fns[i].params)?;
                StrUtil.append(mut out, ");\n    ceesafe_shadow_calls++;\n")?;
                StrUtil.append(mut out, "    if (memcmp(&expected, &actual, sizeof expected) != 0) {\n")?;
                StrUtil.append(mut out, "        ceesafe_shadow_mismatches++;\n")?;
                StrUtil.append(mut out, "        if (ceesafe_shadow_mismatches <= 10)\n")?;
                StrUtil.append(mut out, "            fprintf(stderr, \"[ceesafe-anything] mismatch in ")?;
                StrUtil.append(mut out, name)?;
                StrUtil.append(mut out, "\\n\");\n    }\n    return expected;\n}\n\n")?;
            }
        }
        return Ok(out);
    }

    public fn run(pkgDir: StringView) -> Result<String, AppError> {
        let manifestPath = StrUtil.joinPath(pkgDir, "ceesafe-anything.json")?;
        let manifestText = FsUtil.readText(manifestPath.view())?;
        let root = match (StrUtil.jsonStringField(manifestText.view(), "root")?) {
            Some(r) => r,
            null => { return Err(AppError.InvalidArg); },
        };
        let unit = match (StrUtil.jsonStringField(manifestText.view(), "unit")?) {
            Some(u) => u,
            null => { return Err(AppError.InvalidArg); },
        };
        let pkgName = match (StrUtil.jsonStringField(manifestText.view(), "package_name")?) {
            Some(n) => n,
            null => StrUtil.cloneView("port")?,
        };
        let unitPath = StrUtil.joinPath(root.view(), unit.view())?;
        let lang = Harness.detectUnitLang(unit.view());
        let fns = match (FsUtil.readText(unitPath.view())) {
            Ok(src) => Parser.extractFunctions(lang, src.view())?,
            Err(_) => Vector<FnSpec>.create(),
        };
        if (fns.length == 0) {
            return Err(AppError.NotFound);
        }

        let shadowDir = StrUtil.joinPath(pkgDir, "shadow")?;
        FsUtil.ensureDir(shadowDir.view())?;
        var cFile = StrUtil.cloneView(pkgName.view())?;
        StrUtil.append(mut cFile, "_shadow.c")?;
        let cPath = StrUtil.joinPath(shadowDir.view(), cFile.view())?;
        let flagsPath = StrUtil.joinPath(shadowDir.view(), "flags.txt")?;

        let cCode = Shadow.generateC(unit.view(), pkgName.view(), fns)?;
        let flags = Shadow.generateFlags(fns)?;
        FsUtil.writeText(cPath.view(), cCode.view())?;
        FsUtil.writeText(flagsPath.view(), flags.view())?;

        var out = String.create();
        StrUtil.append(mut out, "Generated shadow wrapper at ")?;
        StrUtil.append(mut out, cPath.view())?;
        StrUtil.append(mut out, "\n  flags: ")?;
        StrUtil.append(mut out, flagsPath.view())?;
        StrUtil.append(mut out, "\n")?;
        return Ok(out);
    }
}
