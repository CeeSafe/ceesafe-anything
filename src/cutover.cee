// `cutover`: generate a drop-in shim (`cutover/<pkg>_cutover.{c,py,mjs,go}` + `cutover/link.txt`)
// routing callers directly to the compiled CeeSafe C-ABI library, and optionally `--apply` it
// by backing up the original unit to `<unit>.orig` and swapping the shim into place.

public struct Cutover {
    fn cType(abi: StringView) -> StringView {
        if (abi == "u32") { return "uint32_t"; }
        if (abi == "i64") { return "int64_t"; }
        if (abi == "u64") { return "uint64_t"; }
        if (abi == "usize") { return "size_t"; }
        if (abi == "f64") { return "double"; }
        if (abi == "bool") { return "bool"; }
        if (abi == "void") { return "void"; }
        return "int32_t";
    }

    fn goType(abi: StringView) -> StringView {
        if (abi == "u32") { return "uint32"; }
        if (abi == "i64") { return "int64"; }
        if (abi == "u64") { return "uint64"; }
        if (abi == "usize") { return "uint"; }
        if (abi == "f64") { return "float64"; }
        if (abi == "bool") { return "bool"; }
        if (abi == "void") { return ""; }
        if (abi == "bytes" || abi == "buffer") { return "[]byte"; }
        if (abi == "cstr") { return "string"; }
        return "int32";
    }

    fn appendCParams(dst: borrow mut String, params: borrow Vector<ParamSpec>) -> Result<void, AppError> {
        if (params.length == 0) {
            StrUtil.append(mut dst, "void")?;
            return Ok();
        }
        for (j in 0..params.length) {
            if (j > 0) {
                StrUtil.append(mut dst, ", ")?;
            }
            let k = params[j].abiKind.view();
            let pn = params[j].name.view();
            if (k == "bytes") {
                StrUtil.append(mut dst, "const uint8_t *")?;
                StrUtil.append(mut dst, pn)?;
                StrUtil.append(mut dst, "_ptr, size_t ")?;
                StrUtil.append(mut dst, pn)?;
                StrUtil.append(mut dst, "_len")?;
            } else if (k == "buffer") {
                StrUtil.append(mut dst, "uint8_t *")?;
                StrUtil.append(mut dst, pn)?;
                StrUtil.append(mut dst, "_ptr, size_t ")?;
                StrUtil.append(mut dst, pn)?;
                StrUtil.append(mut dst, "_len")?;
            } else if (k == "cstr") {
                StrUtil.append(mut dst, "const char *")?;
                StrUtil.append(mut dst, pn)?;
                StrUtil.append(mut dst, "_ptr")?;
            } else {
                StrUtil.append(mut dst, Cutover.cType(k))?;
                StrUtil.append(mut dst, " ")?;
                StrUtil.append(mut dst, pn)?;
            }
        }
        return Ok();
    }

    fn appendCArgs(dst: borrow mut String, params: borrow Vector<ParamSpec>) -> Result<void, AppError> {
        for (j in 0..params.length) {
            if (j > 0) {
                StrUtil.append(mut dst, ", ")?;
            }
            let k = params[j].abiKind.view();
            let pn = params[j].name.view();
            if (k == "bytes" || k == "buffer") {
                StrUtil.append(mut dst, pn)?;
                StrUtil.append(mut dst, "_ptr, ")?;
                StrUtil.append(mut dst, pn)?;
                StrUtil.append(mut dst, "_len")?;
            } else if (k == "cstr") {
                StrUtil.append(mut dst, pn)?;
                StrUtil.append(mut dst, "_ptr")?;
            } else {
                StrUtil.append(mut dst, pn)?;
            }
        }
        return Ok();
    }

    public fn generateC(
        unit: StringView,
        pkgName: StringView,
        fns: borrow Vector<FnSpec>,
    ) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "/* Generated by ceesafe-anything cutover for `")?;
        StrUtil.append(mut out, unit)?;
        StrUtil.append(mut out, "`. Link with cutover/link.txt. */\n")?;
        StrUtil.append(mut out, "#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n\n")?;
        for (i in 0..fns.length) {
            let ret = Cutover.cType(fns[i].returnType.view());
            let name = fns[i].name.view();
            StrUtil.append(mut out, ret)?;
            StrUtil.append(mut out, " port_")?;
            StrUtil.append(mut out, pkgName)?;
            StrUtil.append(mut out, "_")?;
            StrUtil.append(mut out, name)?;
            StrUtil.append(mut out, "(")?;
            Cutover.appendCParams(mut out, fns[i].params)?;
            StrUtil.append(mut out, ");\n\n")?;

            StrUtil.append(mut out, ret)?;
            StrUtil.append(mut out, " ")?;
            StrUtil.append(mut out, name)?;
            StrUtil.append(mut out, "(")?;
            Cutover.appendCParams(mut out, fns[i].params)?;
            StrUtil.append(mut out, ") {\n    ")?;
            if (ret != "void") {
                StrUtil.append(mut out, "return ")?;
            }
            StrUtil.append(mut out, "port_")?;
            StrUtil.append(mut out, pkgName)?;
            StrUtil.append(mut out, "_")?;
            StrUtil.append(mut out, name)?;
            StrUtil.append(mut out, "(")?;
            Cutover.appendCArgs(mut out, fns[i].params)?;
            StrUtil.append(mut out, ");\n}\n\n")?;
        }
        return Ok(out);
    }

    public fn generatePy(
        unit: StringView,
        pkgName: StringView,
        pkgDir: StringView,
        fns: borrow Vector<FnSpec>,
    ) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "# Generated by ceesafe-anything cutover for `")?;
        StrUtil.append(mut out, unit)?;
        StrUtil.append(mut out, "`.\nimport ctypes\n\n")?;
        StrUtil.append(mut out, "_LIB = ctypes.CDLL(\"")?;
        StrUtil.append(mut out, pkgDir)?;
        StrUtil.append(mut out, "/out/lib")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, ".dylib\")\n\n")?;
        for (i in 0..fns.length) {
            let name = fns[i].name.view();
            StrUtil.append(mut out, "def ")?;
            StrUtil.append(mut out, name)?;
            StrUtil.append(mut out, "(")?;
            for (j in 0..fns[i].params.length) {
                if (j > 0) { StrUtil.append(mut out, ", ")?; }
                StrUtil.append(mut out, fns[i].params[j].name.view())?;
            }
            StrUtil.append(mut out, "):\n    fn = _LIB.port_")?;
            StrUtil.append(mut out, pkgName)?;
            StrUtil.append(mut out, "_")?;
            StrUtil.append(mut out, name)?;
            StrUtil.append(mut out, "\n    return fn(")?;
            for (j in 0..fns[i].params.length) {
                if (j > 0) { StrUtil.append(mut out, ", ")?; }
                let k = fns[i].params[j].abiKind.view();
                let pn = fns[i].params[j].name.view();
                if (k == "bytes") {
                    StrUtil.append(mut out, "str(")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, ").encode('utf-8'), len(str(")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, ").encode('utf-8'))")?;
                } else if (k == "cstr") {
                    StrUtil.append(mut out, "str(")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, ").encode('utf-8')")?;
                } else {
                    StrUtil.append(mut out, pn)?;
                }
            }
            StrUtil.append(mut out, ")\n\n")?;
        }
        return Ok(out);
    }

    public fn generateGo(
        unit: StringView,
        pkgName: StringView,
        pkgDir: StringView,
        fns: borrow Vector<FnSpec>,
    ) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "// Generated by ceesafe-anything cutover for `")?;
        StrUtil.append(mut out, unit)?;
        StrUtil.append(mut out, "`.\npackage ")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, "\n\n// #cgo CFLAGS: -I")?;
        StrUtil.append(mut out, pkgDir)?;
        StrUtil.append(mut out, "/include\n// #cgo LDFLAGS: -L")?;
        StrUtil.append(mut out, pkgDir)?;
        StrUtil.append(mut out, "/out -l")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, " -Wl,-rpath,")?;
        StrUtil.append(mut out, pkgDir)?;
        StrUtil.append(mut out, "/out\n// #include \"")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, ".h\"\nimport \"C\"\n\n")?;
        for (i in 0..fns.length) {
            let name = fns[i].name.view();
            let retGo = Cutover.goType(fns[i].returnType.view());
            StrUtil.append(mut out, "func ")?;
            StrUtil.append(mut out, name)?;
            StrUtil.append(mut out, "(")?;
            for (j in 0..fns[i].params.length) {
                if (j > 0) { StrUtil.append(mut out, ", ")?; }
                StrUtil.append(mut out, fns[i].params[j].name.view())?;
                StrUtil.append(mut out, " ")?;
                StrUtil.append(mut out, Cutover.goType(fns[i].params[j].abiKind.view()))?;
            }
            StrUtil.append(mut out, ")")?;
            if (retGo != "") {
                StrUtil.append(mut out, " ")?;
                StrUtil.append(mut out, retGo)?;
            }
            StrUtil.append(mut out, " {\n    ")?;
            if (retGo != "") {
                StrUtil.append(mut out, "return ")?;
                StrUtil.append(mut out, retGo)?;
                StrUtil.append(mut out, "(")?;
            }
            StrUtil.append(mut out, "C.port_")?;
            StrUtil.append(mut out, pkgName)?;
            StrUtil.append(mut out, "_")?;
            StrUtil.append(mut out, name)?;
            StrUtil.append(mut out, "(")?;
            for (j in 0..fns[i].params.length) {
                if (j > 0) { StrUtil.append(mut out, ", ")?; }
                StrUtil.append(mut out, "C.")?;
                StrUtil.append(mut out, Cutover.cType(fns[i].params[j].abiKind.view()))?;
                StrUtil.append(mut out, "(")?;
                StrUtil.append(mut out, fns[i].params[j].name.view())?;
                StrUtil.append(mut out, ")")?;
            }
            StrUtil.append(mut out, ")")?;
            if (retGo != "") {
                StrUtil.append(mut out, ")")?;
            }
            StrUtil.append(mut out, "\n}\n\n")?;
        }
        return Ok(out);
    }

    public fn generateRust(
        unit: StringView,
        pkgName: StringView,
        pkgDir: StringView,
        fns: borrow Vector<FnSpec>,
    ) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "// Generated by ceesafe-anything cutover for `")?;
        StrUtil.append(mut out, unit)?;
        StrUtil.append(mut out, "`. Build with `rustc -L native=")?;
        StrUtil.append(mut out, pkgDir)?;
        StrUtil.append(mut out, "/out`.\n\n#[link(name = \"")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, "\", kind = \"dylib\")]\nextern \"C\" {\n")?;
        for (i in 0..fns.length) {
            let abi = fns[i].returnType.view();
            StrUtil.append(mut out, "    #[link_name = \"port_")?;
            StrUtil.append(mut out, pkgName)?;
            StrUtil.append(mut out, "_")?;
            StrUtil.append(mut out, fns[i].name.view())?;
            StrUtil.append(mut out, "\"] fn ffi_")?;
            StrUtil.append(mut out, fns[i].name.view())?;
            StrUtil.append(mut out, "(")?;
            for (j in 0..fns[i].params.length) {
                if (j > 0) { StrUtil.append(mut out, ", ")?; }
                let k = fns[i].params[j].abiKind.view();
                let pn = fns[i].params[j].name.view();
                if (k == "bytes" || k == "buffer") {
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_ptr: ")?;
                    StrUtil.append(mut out, if (k == "bytes") "*const u8" else "*mut u8")?;
                    StrUtil.append(mut out, ", ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, "_len: usize")?;
                } else {
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, ": ")?;
                    StrUtil.append(
                        mut out,
                        if (k == "u32") "u32"
                            else if (k == "i64") "i64"
                            else if (k == "u64") "u64"
                            else if (k == "usize") "usize"
                            else if (k == "f64") "f64"
                            else if (k == "bool") "bool"
                            else "i32",
                    )?;
                }
            }
            StrUtil.append(mut out, ")")?;
            if (abi != "void") {
                StrUtil.append(mut out, " -> ")?;
                StrUtil.append(
                    mut out,
                    if (abi == "u32") "u32"
                        else if (abi == "i64") "i64"
                        else if (abi == "u64") "u64"
                        else if (abi == "usize") "usize"
                        else if (abi == "f64") "f64"
                        else if (abi == "bool") "bool"
                        else "i32",
                )?;
            }
            StrUtil.append(mut out, ";\n")?;
        }
        StrUtil.append(mut out, "}\n\n")?;
        for (i in 0..fns.length) {
            let retTy = fns[i].returnType.view();
            StrUtil.append(mut out, "pub fn ")?;
            StrUtil.append(mut out, fns[i].name.view())?;
            StrUtil.append(mut out, "(")?;
            for (j in 0..fns[i].params.length) {
                if (j > 0) { StrUtil.append(mut out, ", ")?; }
                let k = fns[i].params[j].abiKind.view();
                let pn = fns[i].params[j].name.view();
                StrUtil.append(mut out, pn)?;
                StrUtil.append(mut out, ": ")?;
                if (k == "bytes" || k == "buffer") {
                    StrUtil.append(mut out, if (k == "bytes") "&[u8]" else "&mut [u8]")?;
                } else {
                    StrUtil.append(
                        mut out,
                        if (k == "u32") "u32"
                            else if (k == "i64") "i64"
                            else if (k == "u64") "u64"
                            else if (k == "usize") "usize"
                            else if (k == "f64") "f64"
                            else if (k == "bool") "bool"
                            else "i32",
                    )?;
                }
            }
            StrUtil.append(mut out, ")")?;
            if (retTy != "void") {
                StrUtil.append(mut out, " -> ")?;
                StrUtil.append(
                    mut out,
                    if (retTy == "u32") "u32"
                        else if (retTy == "i64") "i64"
                        else if (retTy == "u64") "u64"
                        else if (retTy == "usize") "usize"
                        else if (retTy == "f64") "f64"
                        else if (retTy == "bool") "bool"
                        else "i32",
                )?;
            }
            StrUtil.append(mut out, " { unsafe { ")?;
            StrUtil.append(mut out, "ffi_")?;
            StrUtil.append(mut out, fns[i].name.view())?;
            StrUtil.append(mut out, "(")?;
            for (j in 0..fns[i].params.length) {
                if (j > 0) { StrUtil.append(mut out, ", ")?; }
                let k = fns[i].params[j].abiKind.view();
                let pn = fns[i].params[j].name.view();
                if (k == "bytes" || k == "buffer") {
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, if (k == "bytes") ".as_ptr(), " else ".as_mut_ptr(), ")?;
                    StrUtil.append(mut out, pn)?;
                    StrUtil.append(mut out, ".len()")?;
                } else {
                    StrUtil.append(mut out, pn)?;
                }
            }
            StrUtil.append(mut out, ") } }\n\n")?;
        }
        return Ok(out);
    }

    public fn generateTs(
        unit: StringView,
        pkgName: StringView,
        pkgDir: StringView,
        fns: borrow Vector<FnSpec>,
    ) -> Result<String, AppError> {
        var out = String.create();
        StrUtil.append(mut out, "// Generated by ceesafe-anything cutover for `")?;
        StrUtil.append(mut out, unit)?;
        StrUtil.append(mut out, "`.\nexport const CEESAFE_LIB_PATH = \"")?;
        StrUtil.append(mut out, pkgDir)?;
        StrUtil.append(mut out, "/out/lib")?;
        StrUtil.append(mut out, pkgName)?;
        StrUtil.append(mut out, ".dylib\";\nexport const CEESAFE_EXPORTS = [\n")?;
        for (i in 0..fns.length) {
            StrUtil.append(mut out, "  { name: \"")?;
            StrUtil.append(mut out, fns[i].name.view())?;
            StrUtil.append(mut out, "\", symbol: \"port_")?;
            StrUtil.append(mut out, pkgName)?;
            StrUtil.append(mut out, "_")?;
            StrUtil.append(mut out, fns[i].name.view())?;
            StrUtil.append(mut out, "\" },\n")?;
        }
        StrUtil.append(mut out, "];\n")?;
        return Ok(out);
    }

    public fn run(pkgDir: StringView, apply: bool) -> Result<String, AppError> {
        let manifestPath = StrUtil.joinPath(pkgDir, "ceesafe-anything.json")?;
        let manifestText = FsUtil.readText(manifestPath.view())?;
        let root = match (StrUtil.jsonStringField(manifestText.view(), "root")?) {
            Some(r) => r,
            null => { return Err(AppError.InvalidArg); },
        };
        let unit = match (StrUtil.jsonStringField(manifestText.view(), "unit")?) {
            Some(u) => u,
            null => { return Err(AppError.InvalidArg); },
        };
        let pkgName = match (StrUtil.jsonStringField(manifestText.view(), "package_name")?) {
            Some(n) => n,
            null => StrUtil.cloneView("port")?,
        };
        let unitPath = StrUtil.joinPath(root.view(), unit.view())?;
        let lang = Harness.detectUnitLang(unit.view());
        let origSrc = FsUtil.readText(unitPath.view())?;
        let fns = Parser.extractFunctions(lang, origSrc.view())?;
        if (fns.length == 0) {
            return Err(AppError.NotFound);
        }

        let cutDir = StrUtil.joinPath(pkgDir, "cutover")?;
        FsUtil.ensureDir(cutDir.view())?;

        var shimName = StrUtil.cloneView(pkgName.view())?;
        var shimCode = String.create();
        if (lang == "python") {
            StrUtil.append(mut shimName, "_cutover.py")?;
            shimCode = Cutover.generatePy(unit.view(), pkgName.view(), pkgDir, fns)?;
        } else if (lang == "go") {
            StrUtil.append(mut shimName, "_cutover.go")?;
            shimCode = Cutover.generateGo(unit.view(), pkgName.view(), pkgDir, fns)?;
        } else if (lang == "rust") {
            StrUtil.append(mut shimName, "_cutover.rs")?;
            shimCode = Cutover.generateRust(unit.view(), pkgName.view(), pkgDir, fns)?;
        } else if (lang == "ts") {
            StrUtil.append(mut shimName, "_cutover.mjs")?;
            shimCode = Cutover.generateTs(unit.view(), pkgName.view(), pkgDir, fns)?;
        } else {
            StrUtil.append(mut shimName, "_cutover.c")?;
            shimCode = Cutover.generateC(unit.view(), pkgName.view(), fns)?;
        }

        let shimPath = StrUtil.joinPath(cutDir.view(), shimName.view())?;
        FsUtil.writeText(shimPath.view(), shimCode.view())?;

        var linkFlags = String.create();
        StrUtil.append(mut linkFlags, "-L")?;
        StrUtil.append(mut linkFlags, pkgDir)?;
        StrUtil.append(mut linkFlags, "/out -l")?;
        StrUtil.append(mut linkFlags, pkgName.view())?;
        StrUtil.append(mut linkFlags, " -Wl,-rpath,")?;
        StrUtil.append(mut linkFlags, pkgDir)?;
        StrUtil.append(mut linkFlags, "/out\n")?;
        let linkPath = StrUtil.joinPath(cutDir.view(), "link.txt")?;
        FsUtil.writeText(linkPath.view(), linkFlags.view())?;

        var out = String.create();
        StrUtil.append(mut out, "Generated cutover shim at ")?;
        StrUtil.append(mut out, shimPath.view())?;
        StrUtil.append(mut out, "\n  link: ")?;
        StrUtil.append(mut out, linkPath.view())?;
        StrUtil.append(mut out, "\n")?;

        if (apply) {
            var backupPath = StrUtil.cloneView(unitPath.view())?;
            StrUtil.append(mut backupPath, ".orig")?;
            if (!FsUtil.fileExists(backupPath.view())) {
                FsUtil.writeText(backupPath.view(), origSrc.view())?;
            }
            FsUtil.writeText(unitPath.view(), shimCode.view())?;
            StrUtil.append(mut out, "Applied cutover to ")?;
            StrUtil.append(mut out, unitPath.view())?;
            StrUtil.append(mut out, " (backup: ")?;
            StrUtil.append(mut out, backupPath.view())?;
            StrUtil.append(mut out, ")\n")?;
        }
        return Ok(out);
    }
}
